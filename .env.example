# Copy this file to .env (project root) and fill in your Supabase details
# Vite exposes variables that start with VITE_ to the client.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: use a local port for Vite if you need to force 5173
# VITE_DEV_SERVER_PORT=5173
